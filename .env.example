# VoiceAgent Platform — environment variables
# Copy to backend/.env for local dev, or export in your shell.
# NEVER commit real secrets.

# --- Database ---
# Dev default (SQLite). Docker/Postgres:
# postgresql+asyncpg://voice:voice@postgres:5432/voiceagent
DATABASE_URL=sqlite+aiosqlite:///./voiceagent.db

# --- Redis (optional; app works without it via in-memory fallback) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=qwen2.5:1.5b

# --- STT (faster-whisper) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# --- TTS (Piper) ---
TTS_VOICES_DIR=./voices

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
